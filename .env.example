# Copy this file to .env.local for local development. .env.local is git ignored.
# On Vercel, set the same names under Project Settings > Environment Variables. Never commit real values.

# Postgres connection string (Neon). Leave it empty locally to use PGlite, an embedded Postgres
# stored in PGLITE_DIR. POSTGRES_URL is also accepted, the name some Vercel integrations use.
DATABASE_URL=

# Signs the session cookie. Set a long random value in production, for example the output of
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Left empty, a local development default is used and a warning is logged.
SESSION_SECRET=

# Local PGlite data folder, only used when DATABASE_URL is empty. Tests use memory://
PGLITE_DIR=.data/pglite

# Public demo limits (optional). Leave them unset in production to use the defaults shown here;
# tests lower them. A value that is not a positive whole number falls back to the default.
# DEMO_MAX_DOCS=100            owned documents per user (403 limit_reached)
# DEMO_CREATE_PER_10_MIN=20    new documents per user per 10 minutes, create and import together (429)
# DEMO_SAVES_PER_MIN=120       saves per user per minute, per server instance (429)
# DEMO_SHARES_PER_MIN=30       share changes per user per minute, per server instance (429)
# DEMO_SIGNINS_PER_MIN=20      sign ins per IP address per minute, per server instance (429)
